# ==============================================================================
# Zelo - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com suas configurações reais
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL (Supabase ou PostgreSQL local/Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zelo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/zelo?schema=public"

# URL base da aplicação
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Chave secreta para assinatura de tokens de sessão JWT (gerar chave forte)
JWT_SECRET="seu-segredo-jwt-super-seguro-minimo-32-caracteres"

# Supabase (Storage e integrações adicionais)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"
