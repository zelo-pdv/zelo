generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

model Loja {
  id              String           @id @default(cuid())
  name            String           @unique
  ownerName       String
  phone           String?
  email           String?          @unique
  document        String?
  logo            String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  ownerId         String?
  accessGroups    AccessGroup[]
  address         Address[]
  auditLogs       AuditLog[]
  categories      Category[]
  clients         Client[]
  owner           User?            @relation("StoreOwner", fields: [ownerId], references: [id])
  products        Product[]
  sales           Sale[]
  settings        Settings?
  users           User[]
  productVariants ProductVariant[]
  stockMovements  StockMovement[]
}

model Address {
  id           String    @id @default(cuid())
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  lojaId       String
  userId       String?
  clientId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loja         Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lojaId])
  @@index([userId])
  @@index([clientId])
}

model AccessGroup {
  id          String    @id @default(cuid())
  name        String
  description String?
  active      Boolean   @default(true)
  permissions           Json
  discountLimitMode     String?   @default("INHERIT")
  maxDiscountPercentage Decimal?  @db.Decimal(5, 2)
  maxDiscountValue      Decimal?  @db.Decimal(10, 2)
  lojaId                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  loja                  Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  users                 User[]

  @@unique([lojaId, name])
  @@index([lojaId])
}

model User {
  id                    String      @id @default(cuid())
  name                  String
  email                 String      @unique
  password              String
  phone                 String?
  avatar                String?
  active                Boolean     @default(true)
  lastLogin             DateTime?
  discountLimitMode     String?     @default("INHERIT")
  maxDiscountPercentage Decimal?    @db.Decimal(5, 2)
  maxDiscountValue      Decimal?    @db.Decimal(10, 2)
  lojaId                String
  groupId               String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  address     Address[]
  auditLogs   AuditLog[]
  ownedStores    Loja[]          @relation("StoreOwner")
  sales          Sale[]
  stockMovements StockMovement[]
  group          AccessGroup     @relation(fields: [groupId], references: [id])
  loja        Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
  @@index([groupId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  lojaId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  active    Boolean   @default(true)
  address   Address[]
  loja      Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@index([lojaId])
  @@index([lojaId, active])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}


model Category {
  id                String    @id @default(cuid())
  name              String
  active            Boolean   @default(true)
  lojaId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  lowStockThreshold Int?
  loja              Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  products          Product[]

  @@unique([lojaId, name])
  @@index([lojaId])
  @@index([lojaId, updatedAt])
}

model Product {
  id          String           @id @default(cuid())
  code        String?
  barcode     String?
  name        String
  description String?
  image       String?
  costPrice   Decimal?         @db.Decimal(10, 2)
  salePrice   Decimal          @db.Decimal(10, 2)
  stock       Decimal          @default(0) @db.Decimal(10, 3)
  minStock    Decimal?         @db.Decimal(10, 3)
  notes       String?
  lojaId      String
  categoryId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  active      Boolean          @default(true)
  category    Category?        @relation(fields: [categoryId], references: [id])
  loja        Loja             @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  variants       ProductVariant[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([lojaId, code])
  @@index([lojaId])
  @@index([lojaId, active])
  @@index([lojaId, barcode])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}

model ProductVariant {
  id         String   @id @default(cuid())
  name       String
  code       String?
  barcode    String?
  attributes Json?
  image      String?
  costPrice  Decimal? @db.Decimal(10, 2)
  salePrice  Decimal? @db.Decimal(10, 2)
  stock      Decimal  @default(0) @db.Decimal(10, 3)
  minStock   Decimal? @db.Decimal(10, 3)
  active     Boolean  @default(true)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([lojaId, code])
  @@index([lojaId])
  @@index([productId])
  @@index([lojaId, active])
  @@index([lojaId, deletedAt])
}

model Sale {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  total         Decimal    @db.Decimal(10, 2)
  paymentMethod String
  status        SaleStatus @default(PAGO)
  dueDate       DateTime?
  notes         String?
  lojaId        String
  clientId      String?
  clientName    String?
  sellerId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  discount      Decimal?   @default(0.00) @db.Decimal(10, 2)
  saleNumber    Int?
  client        Client?    @relation(fields: [clientId], references: [id])
  loja          Loja       @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  seller        User?      @relation(fields: [sellerId], references: [id])
  items         SaleItem[]

  @@unique([lojaId, saleNumber])
  @@index([lojaId])
  @@index([lojaId, date])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}

model SaleItem {
  id          String          @id @default(cuid())
  saleId      String
  productId   String
  productName String
  variantId   String?
  variantName String?
  quantity    Decimal         @db.Decimal(10, 3)
  unitPrice   Decimal         @db.Decimal(10, 2)
  subtotal    Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([updatedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   Json
  userId    String
  lojaId    String
  createdAt DateTime @default(now())
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lojaId])
  @@index([userId])
  @@index([entity, entityId])
}

model Settings {
  id        String   @id @default(cuid())
  lojaId    String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
}

enum SaleStatus {
  PAGO
  PENDENTE
  CANCELADO
}

enum StockMovementType {
  ENTRY
  OUT
  ADJUSTMENT
  SALE
  SALE_CANCEL
}

model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType @default(ENTRY)
  quantity      Decimal           @db.Decimal(10, 3)
  previousStock Decimal           @db.Decimal(10, 3)
  resultStock   Decimal           @db.Decimal(10, 3)
  title         String            @default("Movimentação de Estoque")
  notes         String?
  isReverted    Boolean           @default(false)
  revertedAt    DateTime?
  
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  variantId     String?
  variant       ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  lojaId        String
  loja          Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt     DateTime          @default(now())

  @@index([lojaId])
  @@index([lojaId, createdAt])
  @@index([lojaId, type])
  @@index([isReverted])
  @@index([productId])
  @@index([variantId])
  @@index([userId])
}
